{
  "name": "sziget-insider-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "prebuild": "node scripts/sync-data.mjs && node scripts/generate-manifest.mjs",
    "dev": "next dev -p 9002",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pulse": "node scripts/pulse-check.mjs",
    "lineup:sync": "node scripts/sync-data.mjs",
    "lineup:scrape": "node scripts/scrape-all-artists.mjs",
    "lineup:clean": "node scripts/clean-lineup.mjs",
    "lineup:vibes": "node scripts/backfill-vibes.mjs",
    "lineup:sync-android": "node scripts/sync-android-assets.mjs",
    "lineup:update": "npm run lineup:scrape && npm run lineup:clean && npm run lineup:vibes && npm run lineup:sync",
    "lineup:rebuild:sziget": "node scripts/rebuild-lineup-from-api.mjs && NEXT_PUBLIC_FESTIVAL_ID=sziget-2026 npm run lineup:sync && NEXT_PUBLIC_FESTIVAL_ID=sziget-2026 npm run lineup:sync-android",
    "lineup:update:sziget": "NEXT_PUBLIC_FESTIVAL_ID=sziget-2026 npm run lineup:update && NEXT_PUBLIC_FESTIVAL_ID=sziget-2026 npm run lineup:sync-android",
    "lineup:update:area53": "NEXT_PUBLIC_FESTIVAL_ID=area53-2026 npm run lineup:update && NEXT_PUBLIC_FESTIVAL_ID=area53-2026 npm run lineup:sync-android",
    "lineup:update:novarock": "NEXT_PUBLIC_FESTIVAL_ID=novarock-2026 npm run lineup:update && NEXT_PUBLIC_FESTIVAL_ID=novarock-2026 npm run lineup:sync-android",
    "lineup:update:frequency": "NEXT_PUBLIC_FESTIVAL_ID=frequency-2026 npm run lineup:update && NEXT_PUBLIC_FESTIVAL_ID=frequency-2026 npm run lineup:sync-android",
    "android:sync:sziget": "NEXT_PUBLIC_FESTIVAL_ID=sziget-2026 npm run lineup:sync-android",
    "android:sync:area53": "NEXT_PUBLIC_FESTIVAL_ID=area53-2026 npm run lineup:sync-android",
    "android:sync:novarock": "NEXT_PUBLIC_FESTIVAL_ID=novarock-2026 npm run lineup:sync-android",
    "android:sync:frequency": "NEXT_PUBLIC_FESTIVAL_ID=frequency-2026 npm run lineup:sync-android",
    "android:sync:erntepunk": "NEXT_PUBLIC_FESTIVAL_ID=ernte-punk-2026 npm run lineup:sync-android",
    "android:sync:rockamring": "NEXT_PUBLIC_FESTIVAL_ID=rock-am-ring-2026 npm run lineup:sync-android",
    "lineup:update:ernte-punk": "NEXT_PUBLIC_FESTIVAL_ID=ernte-punk-2026 npm run lineup:update && NEXT_PUBLIC_FESTIVAL_ID=ernte-punk-2026 npm run lineup:sync-android",
    "lineup:update:rock-am-ring": "NEXT_PUBLIC_FESTIVAL_ID=rock-am-ring-2026 npm run lineup:sync && NEXT_PUBLIC_FESTIVAL_ID=rock-am-ring-2026 npm run lineup:sync-android"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@mui/material-nextjs": "^6.4.5",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.475.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.17",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.3",
    "puppeteer": "^24.3.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.4"
  }
}
